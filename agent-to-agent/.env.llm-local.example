# LLM local via Ollama (grátis, sem chave). Uso:
#   1. Instale o Ollama: https://ollama.com/download
#   2. Baixe o modelo:   ollama pull qwen2.5:7b
#   3. Copie:            cp .env.llm-local.example .env
#   4. Suba:             make up && make smoke   (chat em http://localhost:3000)
#
# host.docker.internal só existe DENTRO dos containers (make up).
# Para rodar os serviços direto no Mac (make run-investimentos / run-ana), troque por:
#   LLM_BASE_URL=http://localhost:11434/v1
#
# Modelos pequenos erram mais em tool calling e no JSON do especialista.
# Se a Ana não delegar ou o especialista falhar, tente qwen3:8b ou um modelo maior.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
